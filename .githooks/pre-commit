#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#staged_files[@]}" -eq 0 ]; then
    exit 0
fi

backend_rust_files=()
mobile_format_files=()

for file in "${staged_files[@]}"; do
    # Patterns are duplicated because `*` does not cross `/`: one for files directly under the
    # directory, one for files in any nested subdirectory.
    case "$file" in
        backend/*.rs|backend/*/*.rs)
            backend_rust_files+=("${file#backend/}")
            ;;
        pwa/src/*/*.js|pwa/src/*/*.jsx|pwa/src/*/*.ts|pwa/src/*/*.tsx|pwa/src/*/*.json|pwa/src/*/*.scss|pwa/src/*/*.css)
            mobile_format_files+=("${file#pwa/}")
            ;;
        pwa/src/*.js|pwa/src/*.jsx|pwa/src/*.ts|pwa/src/*.tsx|pwa/src/*.json|pwa/src/*.scss|pwa/src/*.css)
            mobile_format_files+=("${file#pwa/}")
            ;;
    esac
done

if [ "${#backend_rust_files[@]}" -gt 0 ]; then
    echo "pre-commit: checking Rust formatting for staged backend files"
    if ! (cd backend && cargo fmt --check -- "${backend_rust_files[@]}"); then
        echo "pre-commit: Rust formatting check failed."
        echo "Run: (cd backend && cargo fmt -- ${backend_rust_files[*]})"
        exit 1
    fi
fi

if [ "${#mobile_format_files[@]}" -gt 0 ]; then
    echo "pre-commit: checking Prettier formatting for staged frontend files"
    if ! (cd pwa && npx prettier --check "${mobile_format_files[@]}"); then
        echo "pre-commit: Prettier formatting check failed."
        echo "Run: (cd pwa && npx prettier --write ${mobile_format_files[*]})"
        exit 1
    fi
fi
