# Secrets and optional environment overrides. Non-secret settings may live in config.example.toml.
# DATABASE_URL is read by the app and by Diesel CLI (for example `diesel migration run`).
DATABASE_URL=postgres://wetty_chat:change_me@127.0.0.1:5432/wetty_chat

# Required at startup. Generate once and keep stable across restarts:
#   openssl rand -base64 32
JWT_SIGNING_KEY_BASE64=

# Required secret at startup for Web Push support:
VAPID_PRIVATE_KEY=
# Required public metadata: configure in TOML or use these environment overrides.
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:dev@example.com

# Required public storage settings: configure in TOML or use environment overrides.
# AWS credentials remain in environment variables or the existing AWS provider chain.
# S3_BUCKET_NAME=wetty-chat-local-dev
# AWS_REGION=us-west-2
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=rustfsadmin
# AWS_SECRET_ACCESS_KEY=rustfsadmin
# AWS_SESSION_TOKEN=
# ATTACHMENTS_PREFIX=attachments
# S3_BASE_URL=http://127.0.0.1:9000/wetty-chat-local-dev
# Optional browser upload proxy; runspace sets this and a relative S3_BASE_URL automatically.
# The proxy must strip this prefix and restore the S3 endpoint's Host, including its port.
# S3_UPLOAD_PROXY_PATH=/_storage
# ATTACHMENT_MAX_FILE_SIZE_BYTES=52428800

# Optional, comma-separated. Leave unset to disable CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional listen addresses.
# APP_ADDR=0.0.0.0:3000
# METRICS_ADDR=0.0.0.0:3001

# Optional app-wide non-secret TOML settings; environment variables override the file.
# CHAHUA_CONFIG_PATH=/etc/chahua/config.toml
# Header secrets are referenced as Cookie = { env = "PREVIEW_SITE_COOKIE" } in TOML.
#
# Optional service-token key; otherwise the JWT key is reused.
# SERVICE_TOKEN_HASH_KEY_BASE64=
# Optional APNs secret reference; APNs metadata may be configured in TOML.
# APNS_PRIVATE_KEY_PATH=/run/secrets/apns-private-key.p8

# Optional message search settings. Leave unset to disable message search.
# MESSAGE_SEARCH_ENABLED=false
# MEILI_URL=http://127.0.0.1:7700
# MEILI_MASTER_KEY=local-wetty-chat-meili-master-key
# MESSAGE_SEARCH_INDEX=messages_v1

# Optional node id, defaults to 0.
# NODE_ID=0

# Optional Discuz avatar settings. These are independent of request auth.
# DISCUZ_AVATAR_PUBLIC_URL=https://example.com
# DISCUZ_AVATAR_PATH=/absolute/path/to/discuz/uc_server/data/avatar
