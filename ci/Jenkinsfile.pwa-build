pipeline {
  agent none

  options {
    buildDiscarder(logRotator(numToKeepStr: '90'))
  }

  parameters {
    string(name: 'GIT_COMMIT_SHA', defaultValue: '', description: 'Commit SHA that passed the main Jenkins checks.')
  }

  environment {
    BUILDKIT_HOST = 'tcp://buildkit.jenkins.svc.cluster.local:1234'
    PWA_IMAGE = 'ghcr.io/chahua-im/chahua-pwa'
  }

  stages {
    stage('Validate Input') {
      steps {
        script {
          env.PWA_BUILD_REF = params.GIT_COMMIT_SHA?.trim() ?: 'origin/main'
        }
      }
    }

    stage('Build PWA Artifacts') {
      agent {
        kubernetes {
          defaultContainer 'node'
          yaml '''
apiVersion: v1
kind: Pod
spec:
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
  containers:
    - name: node
      image: node:22-bookworm
      command:
        - cat
      tty: true
    - name: docker
      image: docker:27-cli
      env:
        - name: HOME
          value: /home/jenkins/agent
        - name: DOCKER_CONFIG
          value: /home/jenkins/agent/.docker
      command:
        - cat
      tty: true
'''
        }
      }

      stages {
        stage('Checkout') {
          steps {
            checkout([
              $class: 'GitSCM',
              branches: [[name: env.PWA_BUILD_REF]],
              userRemoteConfigs: [[
                credentialsId: 'github-app',
                refspec: '+refs/heads/*:refs/remotes/origin/*',
                url: 'https://github.com/chahua-im/chahua.git'
              ]]
            ])
          }
        }

        stage('Build') {
          parallel {
            stage('Staging') {
              steps {
                dir('pwa-staging') {
                  checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.PWA_BUILD_REF]],
                    userRemoteConfigs: [[
                      credentialsId: 'github-app',
                      refspec: '+refs/heads/*:refs/remotes/origin/*',
                      url: 'https://github.com/chahua-im/chahua.git'
                    ]]
                  ])

                  dir('wetty-chat-mobile') {
                    sh '''#!/usr/bin/env bash
set -euo pipefail

npm ci
export CI_BUILD_VERSION="PWA-${BUILD_NUMBER}"
npm run build:stg
                    '''

                  }
                  stash name: 'pwa-staging-dist',
                    includes: 'wetty-chat-mobile/dist/**',
                    useDefaultExcludes: false
                }
              }
            }

            stage('Image') {
              steps {
                dir('pwa-image') {
                  checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.PWA_BUILD_REF]],
                    userRemoteConfigs: [[
                      credentialsId: 'github-app',
                      refspec: '+refs/heads/*:refs/remotes/origin/*',
                      url: 'https://github.com/chahua-im/chahua.git'
                    ]]
                  ])

                  container('docker') {
                    withCredentials([usernamePassword(credentialsId: 'ghcr', usernameVariable: 'GHCR_USERNAME', passwordVariable: 'GHCR_TOKEN')]) {
                      dir('wetty-chat-mobile') {
                        sh '''#!/usr/bin/env sh
set -eu

git config --global --add safe.directory "$WORKSPACE"
COMMIT_TAG="$(git rev-parse HEAD)"

docker buildx create \
  --name chahua-builder \
  --driver remote \
  "$BUILDKIT_HOST" \
  --use || docker buildx use chahua-builder

docker buildx inspect --bootstrap

printf '%s' "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USERNAME" --password-stdin

docker buildx build \
  --platform linux/amd64,linux/arm64 \
  --build-arg CI_BUILD_VERSION="PWA-${BUILD_NUMBER}" \
  --cache-from "type=registry,ref=${PWA_IMAGE}:buildcache" \
  --cache-to "type=registry,ref=${PWA_IMAGE}:buildcache,mode=max" \
  -t "${PWA_IMAGE}:${BUILD_NUMBER}" \
  -t "${PWA_IMAGE}:${COMMIT_TAG}" \
  --provenance=false \
  --push \
  .

docker logout ghcr.io || true
                        '''
                      }
                    }
                  }
                }
              }
            }

            stage('Prod') {
              steps {
                dir('pwa-prod') {
                  checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.PWA_BUILD_REF]],
                    userRemoteConfigs: [[
                      credentialsId: 'github-app',
                      refspec: '+refs/heads/*:refs/remotes/origin/*',
                      url: 'https://github.com/chahua-im/chahua.git'
                    ]]
                  ])

                  dir('wetty-chat-mobile') {
                    sh '''#!/usr/bin/env bash
set -euo pipefail

npm ci
export CI_BUILD_VERSION="PWA-${BUILD_NUMBER}"
npm run build:prod
                    '''

                  }
                  stash name: 'pwa-prod-dist',
                    includes: 'wetty-chat-mobile/prod-dist/**',
                    useDefaultExcludes: false
                }
              }
            }
          }
        }

        stage('Archive') {
          steps {
            unstash 'pwa-staging-dist'
            unstash 'pwa-prod-dist'

            zip zipFile: 'wetty-chat-mobile/chahua-staging.zip',
              dir: 'wetty-chat-mobile/dist',
              archive: false

            zip zipFile: 'wetty-chat-mobile/chahua-prod.zip',
              dir: 'wetty-chat-mobile/prod-dist',
              archive: false

            script {
              def pwaImage = "ghcr.io/chahua-im/chahua-pwa:${env.GIT_COMMIT}"

              writeFile file: 'pwa-artifact-metadata.json',
                text: """{
  "buildNumber": "${env.BUILD_NUMBER}",
  "commitSha": "${env.GIT_COMMIT}",
  "sourceRef": "${env.PWA_BUILD_REF}",
  "pwaImage": "${pwaImage}"
}
"""
            }

            archiveArtifacts artifacts: 'wetty-chat-mobile/chahua-staging.zip, wetty-chat-mobile/chahua-prod.zip, pwa-artifact-metadata.json',
              fingerprint: true,
              onlyIfSuccessful: true
          }
        }

        stage('Trigger Staging Deploy') {
          steps {
            build job: 'chahua/deploy/pwa-staging-deploy',
              wait: false,
              parameters: [
                [
                  $class: 'RunParameterValue',
                  name: 'PWA_BUILD',
                  runId: "chahua/chahua-pwa-build#${env.BUILD_NUMBER}"
                ]
              ]
          }
        }
      }
    }
  }
}
