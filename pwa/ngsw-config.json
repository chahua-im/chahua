{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/icon/**", "/icon-maskable/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/i18n/**"]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/_api",
    "!/_api/**",
    "!/.well-known",
    "!/.well-known/**",
    "!/icon",
    "!/icon/**",
    "!/icon-maskable",
    "!/icon-maskable/**",
    "!/emoji",
    "!/emoji/**",
    "!/media",
    "!/media/**"
  ]
}
