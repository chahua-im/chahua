{
  "name": "chahua-pwa",
  "version": "0.0.0",
  "scripts": {
    "postinstall": "node scripts/scope-emoji-picker.mjs",
    "ng": "ng",
    "api:generate": "orval --config orval.config.ts",
    "emoji:generate": "node scripts/generate-emoji-regex.mjs",
    "emoji:picker:generate": "node scripts/generate-picker-emojis.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs --proxy-config proxy.conf.dev.mjs --port 4300 --host 0.0.0.0 --ssl",
    "start": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:online": "API_PROXY_TARGET=https://chahui.app/_api node --env-file-if-exists=.env.local scripts/dev.mjs --proxy-config proxy.conf.dev.mjs --host 0.0.0.0 --ssl",
    "build": "ng build",
    "build:prod": "node scripts/build-prod.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration=ci",
    "test:pwa": "node --test scripts/push-worker.test.mjs scripts/startup-updates.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/service-worker": "22.1.5",
    "@ionic/angular": "^9.0.2",
    "@jsverse/transloco": "^8.4.0",
    "@nicematic/emoji-picker": "2.3.6",
    "file-type": "^21.3.4",
    "heic-to": "^1.5.2",
    "highlight.js": "^11.12.0",
    "ionicons": "^8.1.0",
    "markdown-it": "^15.0.3",
    "mediabunny": "^1.55.7",
    "overlayscrollbars": "^2.16.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@types/node": "^26.5.0",
    "emojibase-data": "17.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "orval": "8.28.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "regenerate-unicode-properties": "10.2.2",
    "regexpu-core": "6.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
